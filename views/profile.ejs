
<!doctype html>
<html>
<head>
    <title>My Pinboard</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">

    <div class="page-header">
        <h1>My Pinboard</h1>
        <p>Logged in as: <%= user.local.email %></p>

        <form action="/logout" method="POST">
            <button type="submit">Logout</button>
        </form>
    </div>

    <!-- form to add a new pin -->
    <div class="add-pin">
        <h2>Add a Pin</h2>

        <form action="/pins" method="POST">

            <input type="text" name="itemName" placeholder="Item name" required>
            <input type="url" name="imageUrl" placeholder="Image URL" required>
            <input type="text" name="category" placeholder="Category" required>
            <input type="text" name="color" placeholder="Color" required>
            <input type="text" name="tags" placeholder="Tags (separate with commas)">
            <button type="submit">Add Pin</button>
        </form>
    </div>

    <!-- show the pins saved by the user -->
    <div class="pins-section">
        <h2>My Pins</h2>
        <% if (pins.length === 0) { %>
            <p>You haven't saved any pins yet.</p>
        <% } %>

        <div class="pins">
            <% pins.forEach(pin => { %>
                <div class="pin">
                    <img src="<%= pin.imageUrl %>" alt="<%= pin.itemName %>">

                    <h3><%= pin.itemName %></h3>
                    <p>Category: <%= pin.category %></p>
                    <p>Color: <%= pin.color %></p>

                    <% if (pin.tags && pin.tags.length > 0) { %>
                        <p>Tags: <%= pin.tags.join(', ') %></p>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>
</div>

<script src="main.js"></script>
</body>
</html>
